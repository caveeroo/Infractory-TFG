[Unit]
Description=Infractory v2 node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/var/lib/infractory/bin/infractory-agent run --config /etc/infractory-agent/config.json
Restart=always
RestartSec=5s
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# ProtectSystem/CapabilityBoundingSet are deliberately not set: prerequisite
# installation, transient unit management, and atomic self-upgrade are explicit
# root duties. Restrict network exposure instead; the agent has no listener.
StateDirectory=infractory

[Install]
WantedBy=multi-user.target
