# Public URL used by operators and outbound agents.
PUBLIC_BASE_URL=https://infractory.example.com

# Application and Pulumi databases may share a cluster but use separate databases.
DATABASE_URL=postgres://infractory:change-me@postgres:5432/infractory
PULUMI_BACKEND_URL=postgres://pulumi:change-me@postgres:5432/infractory_pulumi
POSTGRES_ADMIN_PASSWORD=
INFRACTORY_DB_PASSWORD=
PULUMI_DB_PASSWORD=

# Generate independent high-entropy values. Never commit actual values.
APP_ENCRYPTION_KEY=
PULUMI_CONFIG_PASSPHRASE=
INFRACTORY_TOKEN_PEPPER=

# Runtime selection. Use fake locally; pulumi requires the standard AWS credential chain.
INFRASTRUCTURE_DRIVER=fake
AWS_REGION=eu-west-1
AWS_ALLOWED_REGIONS=eu-west-1

LOG_LEVEL=info
WORKER_CONCURRENCY=4
PULUMI_CONCURRENCY=2
# Keep http://:8080 for local use. Set this to the stable public hostname in
# production; Caddy will then provision and renew TLS automatically.
PUBLIC_ADDRESS=http://:8080
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8080
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
